DATABASE_URL=
DB_SCHEMA=clients

# Firma de cookies ecosystem_session (mismo valor que en ecosystem.atvos.io)
ECOSYSTEM_SECRET=

ADMIN_API_KEY=

# Solo local. En producción dejar en false / no setear.
MOCK_AUTH=false
MOCK_USER=franco

CORS_ORIGINS=http://localhost:5173,https://clients.atvos.io

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Análisis IA — horarios fijos AR (hardcodeados): dom 10:00, mar 23:10, jue 18:00

# Claude CLI (bot Maestro). Requiere `claude` autenticado en el servidor.
CLAUDE_CLI_BIN=claude
ANALISIS_IA_CLAUDE_TIMEOUT=180

# Transcripts Discord — local (desde backend/): transcripts · prod: /opt/atv-clients/transcripts
DISCORD_TRANSCRIPTS_BASE_PATH=

# Comprobantes y uploads — local: uploads · prod Docker: /app/uploads
UPLOAD_DIR=uploads

MKT_BASE_URL=
MKT_AGENT_KEY=
